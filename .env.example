# ==========================================
# LOCAL DEVELOPMENT CONFIGURATION (.env.example)
# Copy this file to .env inside your local PyCharm project.
# NEVER commit .env to GitHub.
# ==========================================

DEBUG=True
SECRET_KEY=local-django-insecure-key-for-development-only-123456
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (SQLite default)
DATABASE_NAME=db.sqlite3

# AI & Offline Toggle (Rule: Offline Mock Adapter is graded)
ENABLE_LIVE_AI=false
OPENAI_API_KEY=
